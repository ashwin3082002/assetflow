{
  "name": "assetflow-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "AssetFlow IT Asset Management System - React frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
