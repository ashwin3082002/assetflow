# Server
PORT=4000
NODE_ENV=development

# PostgreSQL (create the empty databases first: createdb assetflow assetflow_test)
# Tables are created programmatically by TypeORM (synchronize) - never by hand.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/assetflow
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/assetflow_test

# Auth (used from Phase 2)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Uploads (relative to backend/)
UPLOAD_DIR=uploads

# CORS
CORS_ORIGIN=http://localhost:5173

# Business limits
MAX_ACTIVE_REQUESTS=5

# Optional (Phase 12a only). Leave unset to disable caching.
# REDIS_URL=redis://localhost:6379
